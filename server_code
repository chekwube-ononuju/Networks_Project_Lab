#include <WiFiS3.h>

const char* SSID = "TTUguest";
const char* PASS = "fearthestache";

WiFiServer server(80);
const int LED = LED_BUILTIN;

bool ipValid(IPAddress ip) { return !(ip[0]==0 && ip[1]==0 && ip[2]==0 && ip[3]==0); }

void setup() {
  Serial.begin(115200);

  // Wait up to 2s for Serial Monitor, but DON'T block forever
  unsigned long t0 = millis();
  while (!Serial && millis() - t0 < 2000) { delay(10); }

  Serial.println("\n[BOOT] Starting server sketch");

  pinMode(LED, OUTPUT);
  digitalWrite(LED, LOW);

  Serial.print("[WIFI] Connecting to "); Serial.println(SSID);
  WiFi.begin(SSID, PASS);

  // Wait for WiFi association
  t0 = millis();
  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
    if (millis() - t0 > 30000) {
      Serial.println("\n[WIFI] Timeout waiting for WL_CONNECTED");
      while (true) { delay(1000); }
    }
  }
  Serial.println("\n[WIFI] WL_CONNECTED");

  // Wait for DHCP IP (TTUguest often fails here)
  Serial.print("[WIFI] Waiting for DHCP IP");
  t0 = millis();
  while (!ipValid(WiFi.localIP())) {
    delay(300);
    Serial.print(".");
    if (millis() - t0 > 30000) {
      Serial.println("\n[WIFI] Still 0.0.0.0 -> captive portal / no DHCP on guest network.");
      Serial.println("Try phone hotspot or TTU IoT network.");
      while (true) { delay(1000); }
    }
  }

  Serial.println("\n[WIFI] Got IP!");
  Serial.print("Server IP: ");
  Serial.println(WiFi.localIP());

  server.begin();
  Serial.println("[HTTP] Server started on port 80");
}

void loop() {
  WiFiClient client = server.available();
  if (!client) return;

  client.setTimeout(2000);
  String reqLine = client.readStringUntil('\n');
  reqLine.trim();

  Serial.print("[HTTP] ");
  Serial.println(reqLine);

  if (reqLine.indexOf("GET /led?on=1") == 0) digitalWrite(LED, HIGH);
  if (reqLine.indexOf("GET /led?on=0") == 0) digitalWrite(LED, LOW);

  String body = "OK\nIP=" + WiFi.localIP().toString() + "\n";

  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: text/plain");
  client.print("Content-Length: ");
  client.println(body.length());
  client.println("Connection: close");
  client.println();
  client.print(body);

  delay(5);
  client.stop();
}
