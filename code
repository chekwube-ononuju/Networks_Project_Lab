#include <WiFiS3.h>
#include <WiFiSSLClient.h>
#include <ArduinoHttpClient.h>
#include <Wire.h>
#include <Adafruit_AHTX0.h>

// Wi-Fi
const char* WIFI_SSID = "Park East";
const char* WIFI_PASS = "CatchLionWhippet";

// Supabase
const char* SUPABASE_HOST = "peqbwxeykjyakagjbwll.supabase.co";
const int   SUPABASE_PORT = 443;
const char* SUPABASE_KEY  = "sb_publishable_r9TY2z5UCOpLz9P5g1SNsw_idAhhcIL";

WiFiSSLClient tls;
HttpClient http(tls, SUPABASE_HOST, SUPABASE_PORT);

Adafruit_AHTX0 aht;

unsigned long lastSendMs = 0;

void postTelemetry(float tempC, float hum) {
  String json = "{";
  json += "\"device_id\":\"uno-r4-1\",";
  json += "\"temp_c\":" + String(tempC, 2) + ",";
  json += "\"humidity\":" + String(hum, 2);
  json += "}";

  http.beginRequest();
  http.post("/rest/v1/telemetry");
  http.sendHeader("Content-Type", "application/json");
  http.sendHeader("apikey", SUPABASE_KEY);
  http.sendHeader("Authorization", String("Bearer ") + SUPABASE_KEY);
  http.sendHeader("Prefer", "return=minimal");
  http.sendHeader("Content-Length", json.length());
  http.beginBody();
  http.print(json);
  http.endRequest();

  int status = http.responseStatusCode();
  Serial.print("Supabase HTTP: ");
  Serial.println(status);

  // Optional: print body if any
  String body = http.responseBody();
  if (body.length()) Serial.println(body);
}

void setup() {
  Serial.begin(115200);
  while (!Serial) {}

  Wire.begin();

  if (!aht.begin()) {
    Serial.println("AHT20 not found. Check wiring.");
    while (true) delay(1000);
  }
  Serial.println("AHT20 OK.");

  Serial.print("Connecting WiFi");
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected");
  Serial.print("UNO IP: ");
  Serial.println(WiFi.localIP());
}

void loop() {
  if (millis() - lastSendMs >= 1000) { // every 10s
    lastSendMs = millis();

    sensors_event_t humEvent, tempEvent;
    aht.getEvent(&humEvent, &tempEvent);

    float t = tempEvent.temperature;
    float h = humEvent.relative_humidity;

    Serial.print("TempC="); Serial.print(t, 2);
    Serial.print("  Hum="); Serial.println(h, 2);

    postTelemetry(t, h);
  }
}
